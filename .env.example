# Better Tap headless storefront — environment variables
#
# Publish these in Vercel: Project → Settings → Environment Variables.
# NEVER commit real values. Local dev uses .env.local (gitignored).
# For a static site, only api/shopify-admin.js reads these; the browser
# never sees the Admin token.

# --- Storefront (publishable — safe in browser) -----------------------
# Used by scripts/prerender.js and (defaulted in) assets/js/shopify.js.
SHOPIFY_STORE_DOMAIN=dqz0fm-jv.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2025-07
SHOPIFY_STOREFRONT_TOKEN=71b65eca82761a181ff873015953c182

# --- Admin (SECRET — server-side only, never in client JS) ------------
# Create the token in Shopify Admin → Apps & sales channels →
# Develop apps → BetterTap Website → API credentials → Admin API access
# token. Required scopes: write_products, write_inventory, read_orders.
SHOPIFY_ADMIN_TOKEN=shpat_REPLACE_ME
SHOPIFY_ADMIN_API_VERSION=2025-07

# --- Auth for the Admin proxy (SECRET) --------------------------------
# Random string (>= 32 chars). Clients must send it as `x-bt-auth`
# header. Generate one and paste it in Vercel + wherever the CRM /
# internal tools call the proxy from.
BT_ADMIN_SHARED_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
